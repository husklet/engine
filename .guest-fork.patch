+        const DWORD error = GetLastError();
+        (void)CloseHandle(object);
+        errno = (error == ERROR_ACCESS_DENIED) ? EPERM : ESRCH;
+        return -1;
+    }
+    (void)CloseHandle(object);
+    return 0;
+}
