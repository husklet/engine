+        return -1;
+    }
+    AcquireSRWLockExclusive(&hl_windows_children_lock);
+    for (index = 0; index < HL_WINDOWS_CHILD_CAPACITY; index++) {
+        if (hl_windows_children[index].used && hl_windows_children[index].id == (DWORD)pid) {
+            owned = 1;
+            break;
+        }
