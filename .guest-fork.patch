index 1d8ea6b6..fe0863f7 100644
--- a/src/host/windows/memory.c
+++ b/src/host/windows/memory.c
@@ -852,15 +852,152 @@ static hl_host_result hl_windows_memory_reserve_code(void *context, uint64_t siz
